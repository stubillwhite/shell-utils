#!/bin/bash
#
# Usage:
#    query-artifactory FLAGS [ARTIFACT]
#
# Flags:
#    -v     Display versions
#    -d     Download ARTIFACT

credentials_file="${HOME}/.ivy2/.credentials"
url='https://rt.artifactory.tio.systems'

if [[ ! -r "${credentials_file}" ]]; then
    printf 'Credentials file not found: %s\n' "${credentials_file}" >&2
    exit 1
fi

username=$(awk -F= '$1 == "username" || $1 == "user" {
    print substr($0, index($0, "=") + 1)
    exit
}' "${credentials_file}")
token=$(awk -F= '$1 == "password" {
    print substr($0, index($0, "=") + 1)
    exit
}' "${credentials_file}")

if [[ -z "${username}" || -z "${token}" ]]; then
    printf 'Credentials file must contain username and password: %s\n' "${credentials_file}" >&2
    exit 1
fi

usage() {
    printf 'Usage: %s [-v | -d ARTIFACT]\n' "$0" >&2
}

display-repository-contents() {
    local action=$1
    local repo=$2
    local response

    if ! response=$(curl --fail --silent --show-error \
        -u "${username}:${token}" \
        -H "X-JFrog-Art-Api: ${token}" \
        -H 'Content-Type: text/plain' \
        --request POST "${url}/artifactory/api/search/aql" \
        --data-binary @- <<EOF
items.find(
        {
            "repo":{"\$eq":"${repo}"}
        }
    )
EOF
    ); then
        printf 'Artifactory request failed for repository: %s\n' "${repo}" >&2
        return 1
    fi

    if jq -e '(.errors? // []) | length > 0' <<< "${response}" > /dev/null; then
        jq -r '.errors[]?.message // "Unknown Artifactory error"' <<< "${response}" >&2
        return 1
    fi

    if ! jq -e '(.results? | type) == "array"' <<< "${response}" > /dev/null; then
        printf 'Unexpected response from Artifactory for repository: %s\n' "${repo}" >&2
        return 1
    fi

    case "${action}" in
        "verbose")
            jq -r '.results[] | select(.name | contains(".pom")) | [.repo, .path, .name] | @tsv' <<< "${response}" \
                | sort \
                | uniq \
                | awk '{ print $1 "/" $2 "/" $3; }'
            ;;

        "default")
            echo "$repo"

            jq -r '.results[].name | select(contains(".pom"))' <<< "${response}" \
                | awk '{ print " - " $1; }'

            echo
            ;;
    esac
}

download-artifact() {
    local path=$1

    if [[ -z "${path}" ]]; then
        usage
        return 1
    fi

    wget \
        --https-only \
        --header "X-JFrog-Art-Api:${token}" \
        "${url}/artifactory/${path}"
}

case "${1:-}" in
    "-d")
        download-artifact "${2:-}"
        ;;
    "-v"|"")
        action="verbose"
        [[ "${1:-}" == "" ]] && action="default"
        display-repository-contents "${action}" sbt-recs-libs-local &&
        display-repository-contents "${action}" sbt-recs-apps-local &&
        display-repository-contents "${action}" maven-recs-libs-local
        ;;
    *)
        usage
        exit 1
        ;;
esac
