#!/usr/bin/env bash

# make run-lookup ARGS="--dataset mhub-current 27844528009" | format-xml | pygmentize

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

dataset=$1
key=$2

case "${dataset}" in
    rdp-ani|rdp-ani-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
        region=us-east-2 ;;

    mhub-ani|mhub-ani-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
        region=us-east-1 ;;

    rdp-apr|rdp-apr-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
        region=us-east-2 ;;

    mhub-apr|mhub-apr-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
        region=us-east-1 ;;

    *)
        echo "Unknown dataset ${dataset}"
        exit 1 ;;
esac

pushd "${SCRIPT_DIR}" > /dev/null || exit 1
make run-lookup ARGS="--db $1.duckdb --dataset ${dataset} --region ${region} ${key}" || exit $?
popd > /dev/null || exit 1
