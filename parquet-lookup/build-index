#!/usr/bin/env bash

# vim:fdm=marker

set -euo pipefail

## Selection                                                                {{{1
## =============================================================================

# August workshop datasets
# BUILD=(mhub_ani 20260825)
# BUILD=(mhub_apr 20260825)

# RDP bugfix phase one
# BUILD=(rdp_ani 20260928-000001 20260827-063016 20260827-063016)
# BUILD=(rdp_apr 20260827-063016)

# RDP bugfix phase two with new Golden Works
# BUILD=(rdp_ani 20261005-200000 20261005-200000 20261005-200000)
# BUILD=(rdp_apr 20261005-200000)

# OpenAlex
# BUILD=(mhub_openalex_ani 20260629 073848)
BUILD=(rdp_openalex_ani 20261005-200000)

## Datasets                                                                 {{{1
## =============================================================================

die() {
    echo "build-index: $*" >&2
    exit 1
}

index_args() {
    local name=$1 key_column=$2 content_column=$3 region=$4
    shift 4
    printf -- '--dataset %s --db %s.duckdb --key-column %s --content-column %s --region %s' \
        "${name}" "${name}" "${key_column}" "${content_column}" "${region}"
    printf -- ' --path %s' "$@"
}

# MHub ANI: <timestamp>
mhub_ani() {
    (($# == 1)) || die "mhub_ani expects 1 timestamp, got $#"
    index_args "mhub-ani-${1:0:8}" key xml us-east-1 \
        "s3://sccontent-staging-corecomplete-xocs/sccontent-ani-parquet-prod/${1}/"
}

# RDP ANI: <core> <non-scopus-publication> <preprint> timestamps
rdp_ani() {
    (($# == 3)) || die "rdp_ani expects 3 timestamps (core, non-scopus, preprint), got $#"
    local root=s3://sccontent-prod-corecomplete-xocs-us-east-2/prod/xocs/ANI
    index_args "rdp-ani-${1:0:8}" id xml us-east-2 \
        "${root}/Core/output/three_column/${1}/" \
        "${root}/Non-scopus-publication/output/three_column/${2}/" \
        "${root}/Preprint/output/three_column/${3}/"
}

mhub_apr() {
    (($# == 1)) || die "mhub_apr expects 1 timestamp, got $#"
    index_args "mhub-apr-${1:0:8}" key xml us-east-1 \
        "s3://sccontent-staging-corecomplete-xocs/sccontent-apr-parquet-prod/${1}/"
}

rdp_apr() {
    (($# == 1)) || die "rdp_apr expects 1 timestamp, got $#"
    index_args "rdp-apr-${1:0:8}" id xml us-east-2 \
        "s3://sccontent-prod-corecomplete-xocs-us-east-2/prod/xocs/APR/output/three_column/${1}/"
}

mhub_openalex_ani() {
    (($# == 2)) || die "mhub_openalex_ani expects 2 arguments (date, time), got $#"
    index_args "mhub-openalex-ani-${1}" EID XML us-east-1 \
        "s3://mhub-d2m-export-parquet-prod/ANI/${1}/Ani_Eid_XML_${1}_${2}.parquet"
}

rdp_openalex_ani() {
    (($# == 1)) || die "rdp_openalex_ani expects 1 timestamp, got $#"
    index_args "rdp-openalex-ani-${1:0:8}" id xml us-east-2 \
        "s3://sccontent-prod-corecomplete-xocs-us-east-2/prod/openalex/ANI/Core/output/three_column/${1}/"
}

## Script                                                                   {{{1
## =============================================================================

ARGS=$("${BUILD[@]}")
DATABASE=${ARGS#*--db }
DATABASE=${DATABASE%% *}

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
cd "${SCRIPT_DIR}"
if [[ -e "${DATABASE}" ]]; then
    echo "build-index: ${DATABASE} already exists; skipping index build" >&2
else
    make run-build-index ARGS="${ARGS}"
fi
