#!/usr/bin/env bash

# vim:fdm=marker

set -euo pipefail

## Helpers                                                                  {{{1
## =============================================================================

die() {
    echo "build-index: $*" >&2
    exit 1
}

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# shellcheck source=data-versions
source "${SCRIPT_DIR}/data-versions"

index_args() {
    local name=$1 key_column=$2 content_column=$3 region=$4
    shift 4
    if [[ "${LIST_PATHS}" == true ]]; then
        local label=${name%-*} path
        label=$(printf '%s' "${label//-/ }" | tr '[:lower:]' '[:upper:]')
        label=${label/MHUB/MHub}
        label=${label/OPENALEX/OpenAlex}
        for path in "$@"; do
            printf '%s: %s\n' "${label}" "${path}"
        done
        return
    fi
    printf -- '--dataset %s --db %s.duckdb --key-column %s --content-column %s --region %s' \
        "${name}" "${name}" "${key_column}" "${content_column}" "${region}"
    printf -- ' --path %s' "$@"
}

