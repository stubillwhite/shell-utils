#!/usr/bin/env bash

# vim:fdm=marker

set -euo pipefail

## Datasets                                                                 {{{1
## =============================================================================

die() {
    echo "build-index: $*" >&2
    exit 1
}

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# shellcheck source=data-versions
source "${SCRIPT_DIR}/data-versions"

index_args() {
    local name=$1 key_column=$2 content_column=$3 region=$4
    shift 4
    printf -- '--dataset %s --db %s.duckdb --key-column %s --content-column %s --region %s' \
        "${name}" "${name}" "${key_column}" "${content_column}" "${region}"
    printf -- ' --path %s' "$@"
}

# MHub ANI
mhub_ani() {
    index_args "mhub-ani-${MHUB_VERSION:0:8}" key xml us-east-1 \
        "s3://sccontent-staging-corecomplete-xocs/sccontent-ani-parquet-prod/${MHUB_VERSION}/"
}

rdp_ani() {
    local root=s3://sccontent-prod-corecomplete-xocs-us-east-2/prod/xocs/ANI
    index_args "rdp-ani-${RDP_VERSION:0:8}" id xml us-east-2 \
        "${root}/Core/output/three_column/${RDP_VERSION}/" \
        "${root}/Non-scopus-publication/output/three_column/${RDP_VERSION}/" \
        "${root}/Preprint/output/three_column/${RDP_VERSION}/"
}

mhub_apr() {
    index_args "mhub-apr-${MHUB_VERSION:0:8}" key xml us-east-1 \
        "s3://sccontent-staging-corecomplete-xocs/sccontent-apr-parquet-prod/${MHUB_VERSION}/"
}

rdp_apr() {
    index_args "rdp-apr-${RDP_VERSION:0:8}" id xml us-east-2 \
        "s3://sccontent-prod-corecomplete-xocs-us-east-2/prod/xocs/APR/output/three_column/${RDP_VERSION}/"
}

# MHub OpenAlex ANI: MHUB_OPENALEX_VERSION is <date>-<time>
mhub_openalex_ani() {
    local date=${MHUB_OPENALEX_VERSION%-*} time=${MHUB_OPENALEX_VERSION#*-}
    index_args "mhub-openalex-ani-${date}" EID XML us-east-1 \
        "s3://mhub-d2m-export-parquet-prod/ANI/${date}/Ani_Eid_XML_${date}_${time}.parquet"
}

rdp_openalex_ani() {
    index_args "rdp-openalex-ani-${RDP_OPENALEX_VERSION:0:8}" id xml us-east-2 \
        "s3://sccontent-prod-corecomplete-xocs-us-east-2/prod/openalex/ANI/Core/output/three_column/${RDP_OPENALEX_VERSION}/"
}

rdp_ekb_ani() {
    index_args "rdp-ekb-ani-${RDP_EKB_VERSION:0:8}" id xml us-east-2 \
        "s3://sccontent-prod-corecomplete-xocs-us-east-2/prod/ekb/ANI/Core/output/three_column/${RDP_EKB_VERSION}/"
}

PRESETS=(mhub_ani rdp_ani mhub_apr rdp_apr mhub_openalex_ani rdp_openalex_ani rdp_ekb_ani)

## Script                                                                   {{{1
## =============================================================================

build() {
    local args database
    args=$("$1")
    database=${args#*--db }
    database=${database%% *}
    if [[ -e "${database}" ]]; then
        echo "build-index: ${database} already exists; skipping index build" >&2
    else
        make run-build-index ARGS="${args}"
    fi
}

if (($# > 0)); then
    SELECTED=("$@")
else
    SELECTED=("${PRESETS[@]}")
fi
for preset in "${SELECTED[@]}"; do
    [[ " ${PRESETS[*]} " == *" ${preset} "* ]] || die "unknown preset ${preset} (expected one of: ${PRESETS[*]})"
done

cd "${SCRIPT_DIR}"
for preset in "${SELECTED[@]}"; do
    build "${preset}"
done
