#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=data-versions
source "${SCRIPT_DIR}/data-versions"

mhub="mhub-ani-${MHUB_VERSION:0:8}.duckdb"
rdp="rdp-ani-${RDP_VERSION:0:8}.duckdb"

echo "Finding common keys in ${mhub} and ${rdp}"

duckdb --ascii -c "
attach '${mhub}' as mhub;
attach '${rdp}' as rdp;
select distinct 
    m.key 
from mhub.key_index m inner join rdp.key_index r on m.key = r.key 
limit 25;
"
