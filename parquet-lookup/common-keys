#!/usr/bin/env bash

set -euo pipefail

mhub="mhub-ani-20260825.duckdb"
rdp="rdp-ani-20261016.duckdb"

echo "Finding common keys in ${mhub} and ${rdp}"

duckdb --ascii -c "
attach '${mhub}' as mhub;
attach '${rdp}' as rdp;
select distinct 
    m.key 
from mhub.key_index m inner join rdp.key_index r on m.key = r.key 
limit 25;
"
