#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

pushd "${SCRIPT_DIR}" > /dev/null || exit 1

DATA_DIR=$(readlink -f "${1:-example-data}")
mhubDir="${DATA_DIR}/mhub-ani-20260825"
rdpDir="${DATA_DIR}/rdp-ani-20261016"

list_files() {
    find "$1" -maxdepth 1 -type f ! -name '.*' -exec basename {} \; | sort
}

comm -12 <(list_files "${mhubDir}") <(list_files "${rdpDir}") \
    | while IFS= read -r name; do
        echo "${mhubDir}/${name} ${rdpDir}/${name}"
    done

popd > /dev/null || exit 1
