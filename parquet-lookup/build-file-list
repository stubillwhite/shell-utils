#!/usr/bin/env bash

set -euo pipefail

DATA_DIR=$(readlink -f "${1:-example-data-ani}")

list_files() {
    find "$1" -maxdepth 1 -type f ! -name '.*' -exec basename {} \; | sort
}

comm -12 <(list_files "${DATA_DIR}/mhub") <(list_files "${DATA_DIR}/rdp") \
    | while IFS= read -r name; do
        echo "${DATA_DIR}/mhub/${name} ${DATA_DIR}/rdp/${name}"
    done
