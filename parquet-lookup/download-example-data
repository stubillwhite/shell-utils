#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=data-versions
source "${SCRIPT_DIR}/data-versions"

ANI_DATASETS=(
    "mhub-ani-${MHUB_VERSION:0:8}"
    "rdp-ani-${RDP_VERSION:0:8}"
)

ANI_IDS=(
84934895772
)

APR_DATASETS=(
    "mhub-apr-${MHUB_VERSION:0:8}"
    "rdp-apr-${RDP_VERSION:0:8}"
)

APR_IDS=(
)

OPENALEX_DATASETS=(
    "mhub-openalex-ani-${MHUB_OPENALEX_VERSION:0:8}"
    "rdp-openalex-ani-${RDP_OPENALEX_VERSION:0:8}"
)

OPENALEX_IDS=(
84934895772
)

datasetPath="example-data"

for dataset in "${ANI_DATASETS[@]}" "${APR_DATASETS[@]}" "${OPENALEX_DATASETS[@]}"
do
    mkdir -p "${datasetPath}/${dataset}"
done

temporaryPath=$(mktemp -d "${datasetPath}/.download.XXXXXX")
trap 'rm -f "${temporaryPath}/raw.xml" "${temporaryPath}/formatted.xml"; rmdir "${temporaryPath}"' EXIT

download_document() {
    local dataset=$1
    local id=$2
    local outputPath=$3

    if [ -s "${outputPath}" ]; then
        return 0
    fi

    rm -f "${outputPath}" || return 1
    echo "Downloading record ${id} from ${dataset}" >&2

    if ! ./query-dataset "${dataset}" "${id}" > "${temporaryPath}/raw.xml"; then
        echo "Failed to download record ${id} from ${dataset}" >&2
        return 1
    fi

    if [ ! -s "${temporaryPath}/raw.xml" ]; then
        echo "Skipping empty record ${id} from ${dataset}" >&2
        return 0
    fi

    if ! xmllint --format "${temporaryPath}/raw.xml" > "${temporaryPath}/formatted.xml"; then
        echo "Invalid XML for record ${id} from ${dataset}" >&2
        return 1
    fi

    mv "${temporaryPath}/formatted.xml" "${outputPath}"
}

status=0
for id in "${ANI_IDS[@]}"
do
    for dataset in "${ANI_DATASETS[@]}"
    do
        download_document "${dataset}" "${id}" "${datasetPath}/${dataset}/${id}.xml" || status=1
    done
done

# for id in "${APR_IDS[@]}"
# do
#     for dataset in "${APR_DATASETS[@]}"
#     do
#         download_document "${dataset}" "${id}" "${datasetPath}/${dataset}/${id}.xml" || status=1
#     done
# done

for id in "${OPENALEX_IDS[@]}"
do
    for dataset in "${OPENALEX_DATASETS[@]}"
    do
        download_document "${dataset}" "${id}" "${datasetPath}/${dataset}/${id}.xml" || status=1
    done
done

exit "${status}"
